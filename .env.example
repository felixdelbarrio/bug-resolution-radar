# Configuracion basica (negocio)
APP_TITLE=Bug Resolution Radar
THEME=light
DATA_PATH=data/issues.json
NOTES_PATH=data/notes.json
INSIGHTS_LEARNING_PATH=data/insights_learning.json
LOG_LEVEL=INFO

# Desktop
# true: contenedor embebido (default) | false: navegador del sistema
BUG_RESOLUTION_RADAR_DESKTOP_WEBVIEW=true

# Jira
SUPPORTED_COUNTRIES=México,España,Perú,Colombia,Argentina
JIRA_BASE_URL=
JIRA_SOURCES_JSON=[]
JIRA_INGEST_DISABLED_SOURCES_JSON=[]
JIRA_BROWSER=chrome
JIRA_COOKIE_SOURCE=browser
JIRA_COOKIE_HEADER=
JIRA_BROWSER_LOGIN_URL=
JIRA_BROWSER_LOGIN_WAIT_SECONDS=90
JIRA_BROWSER_LOGIN_POLL_SECONDS=2.0

# Helix
HELIX_SOURCES_JSON=[]
HELIX_INGEST_DISABLED_SOURCES_JSON=[]
HELIX_BROWSER=chrome
HELIX_COOKIE_SOURCE=browser
HELIX_COOKIE_HEADER=
HELIX_DATA_PATH=data/helix_dump.json
HELIX_DASHBOARD_URL=
HELIX_PROXY=
HELIX_SSL_VERIFY=
HELIX_CA_BUNDLE=
HELIX_CONNECT_TIMEOUT=10
HELIX_READ_TIMEOUT=30
HELIX_MAX_READ_TIMEOUT=120
HELIX_PROXY_MIN_READ_TIMEOUT=30
HELIX_DRYRUN_CONNECT_TIMEOUT=10
HELIX_DRYRUN_READ_TIMEOUT=60
HELIX_MIN_CHUNK_SIZE=10
HELIX_MAX_PAGES=200
HELIX_MAX_INGEST_SECONDS=900
HELIX_ARSQL_BASE_URL=
HELIX_ARSQL_DATASOURCE_UID=
HELIX_ARSQL_SOURCE_SERVICE_N1=ENTERPRISE WEB
HELIX_ARSQL_LIMIT=500
HELIX_ARSQL_DS_AUTH=IMS-JWT JWT PLACEHOLDER
HELIX_ARSQL_CLIENT_TYPE=4021
HELIX_ARSQL_GRAFANA_ORG_ID=
HELIX_ARSQL_GRAFANA_DEVICE_ID=
HELIX_ARSQL_DASHBOARD_URL=
HELIX_INC_LOOKUP_BATCH_SIZE=25
HELIX_BROWSER_LOGIN_WAIT_SECONDS=90
HELIX_BROWSER_LOGIN_POLL_SECONDS=2.0

# Dashboard e informe
DASHBOARD_SUMMARY_CHARTS=timeseries,open_priority_pie,resolution_hist
TREND_SELECTED_CHARTS=timeseries,open_priority_pie,resolution_hist
DASHBOARD_FILTER_STATUS_JSON=[]
DASHBOARD_FILTER_PRIORITY_JSON=[]
DASHBOARD_FILTER_ASSIGNEE_JSON=[]
KEEP_CACHE_ON_SOURCE_DELETE=false
REPORT_PPT_DOWNLOAD_DIR=
ANALYSIS_LOOKBACK_MONTHS=12
QUINCENA_LAST_FINISHED_ONLY=false
USAR_ULTIMA_QUINCENA_FINALIZADA=
PERIOD_REPORT_FUNCTIONALITY_DETAIL_ENABLED=false
OPEN_ISSUES_FOCUS_MODE=criticidad_alta
COUNTRY_ROLLUP_SOURCES_JSON=[]
JIRA_ROOT_CAUSE_LABELS_BY_COUNTRY_JSON=[]
